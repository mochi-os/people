{
	"version": "3.2",
	"label": "app.name",
	"classes": ["person", "book"],
	"paths": ["people"],
	"services": ["people", "friends", "contacts"],

	"architecture": {"engine": "starlark", "version": 4},
	"execute": ["lib/attachments.star", "people.star", "contacts.star"],

	"require": {"version": {"minimum": "2.0"}},

	"database": {
		"schema": 13,
		"file": "people.db",
		"create": {"function": "database_create"},
		"upgrade": {"function": "database_upgrade"},
	},

	"icons": [
		{"action": "", "label": "app.name", "file": "images/icon.svg"}
	],

	"actions": {
		"": {"file": "web/dist/index.html"},
		"assets": {"files": "web/dist/assets"},
		"images": {"files": "web/dist/images"},
		"contacts": {"file": "web/dist/index.html"},
		"contacts/:id": {"file": "web/dist/index.html"},
		"books/:id": {"file": "web/dist/index.html"},
		"-/contacts": {"function": "action_contacts"},
		"-/contacts/get": {"function": "action_contact_get"},
		"-/contacts/create": {"function": "action_contact_create"},
		"-/contacts/update": {"function": "action_contact_update"},
		"-/contacts/delete": {"function": "action_contact_delete"},
		"-/contacts/search": {"function": "action_contact_search"},
		"-/contacts/changes": {"function": "action_contacts_changes"},
		"-/contacts/batch": {"function": "action_contacts_batch"},
		"-/books": {"function": "action_books"},
		"-/books/create": {"function": "action_book_create"},
		"-/books/rename": {"function": "action_book_rename"},
		"-/books/delete": {"function": "action_book_delete"},
		"-/friends/invite": {"function": "action_friend_invite"},
		"-/friends/accept": {"function": "action_friend_accept"},
		"-/friends/ignore": {"function": "action_friend_ignore"},
		"-/friends/remove": {"function": "action_friend_remove"},
		// Compatibility aliases for the shipped Android client, kept for one
		// release: the old routes, inputs named id, and the old response shapes.
		"-/friends": {"function": "action_friends_alias_list"},
		"-/friends/create": {"function": "action_friends_alias_create"},
		"-/friends/delete": {"function": "action_friends_alias_delete"},
		"-/friends/search": {"function": "action_friends_alias_search"},
		// CardDAV, served by core's DAV engine over the dav/* functions below:
		// public because the engine authenticates every request itself, with a
		// token the token actions mint.
		"carddav/*path": {"feature": "carddav", "public": true},
		"-/token/create": {"function": "action_token_create"},
		"-/token/list": {"function": "action_token_list"},
		"-/token/delete": {"function": "action_token_delete"},
		"groups": {"file": "web/dist/index.html"},
		"groups/:id": {"file": "web/dist/index.html"},
		"-/groups/list": {"function": "action_groups"},
		"-/groups/get": {"function": "action_group_get"},
		"-/groups/create": {"function": "action_group_create"},
		"-/groups/update": {"function": "action_group_update"},
		"-/groups/delete": {"function": "action_group_delete"},
		"-/groups/members/add": {"function": "action_group_member_add"},
		"-/groups/members/remove": {"function": "action_group_member_remove"},
		"-/users/search": {"function": "action_users_search"},
		"-/preferences/get": {"function": "action_preferences_get"},
		"-/preferences/set": {"function": "action_preferences_set"},
		"-/welcome": {"function": "action_welcome"},
		"-/welcome/seen": {"function": "action_welcome_seen"},

		":person": {"file": "web/dist/index.html", "public": true, "opengraph": "opengraph_person"},
		":person/assets": {"files": "web/dist/assets", "public": true},
		":person/images": {"files": "web/dist/images", "public": true},
		":person/-/information": {"function": "action_information", "public": true},
		":person/-/avatar": {"function": "action_avatar", "public": true},
		":person/-/avatar/set": {"function": "action_avatar_set"},
		":person/-/banner": {"function": "action_banner", "public": true},
		":person/-/banner/set": {"function": "action_banner_set"},
		":person/-/favicon": {"function": "action_favicon", "public": true},
		":person/-/favicon/set": {"function": "action_favicon_set"},
		":person/-/style": {"function": "action_style", "public": true},
		":person/-/style/set": {"function": "action_style_set"},
		":person/-/profile/set": {"function": "action_profile_set"},
		":person/-/name/set": {"function": "action_name_set"},
		":person/-/privacy/set": {"function": "action_privacy_set"}
	},

	"events": {
		"friend/accept": {"function": "event_accept"},
		"friend/cancel": {"function": "event_cancel"},
		"friend/invite": {"function": "event_invite"},
		"friend/remove": {"function": "event_remove"},
		"information": {"function": "event_information", "anonymous": true},
		"avatar": {"function": "event_avatar", "anonymous": true},
		"banner": {"function": "event_banner", "anonymous": true},
		"favicon": {"function": "event_favicon", "anonymous": true},
		"style": {"function": "event_style", "anonymous": true}
	},

	// Contact rows live in this app's database and no core API exposes them, so
	// these declarations are the only thing standing between another installed
	// app and the user's social graph; get, list and count answer only the
	// friends among the contacts. users/search is deliberately ungated: it
	// searches the public directory, which mochi.directory.search already offers
	// any app directly, so a permission here would be theatre.
	"functions": {
		"get": {"function": "function_get", "permission": "friends/read"},
		"list": {"function": "function_list", "permission": "friends/read"},
		"count": {"function": "function_count", "permission": "friends/read"},
		"users/search": {"function": "function_users_search"},
		"groups/list": {"function": "function_groups_list", "permission": "groups/read"},
		"contacts/list": {"function": "function_contacts_list", "permission": "contacts/read"},
		"contacts/get": {"function": "function_contacts_get", "permission": "contacts/read"},
		"contacts/search": {"function": "function_contacts_search", "permission": "contacts/read"},
		"contacts/birthdays": {"function": "function_contacts_birthdays", "permission": "contacts/read"},
		"dav/collections": {"function": "function_dav_collections", "permission": "contacts/read"},
		"dav/collections/create": {"function": "function_dav_collection_create", "permission": "contacts/read"},
		"dav/collections/delete": {"function": "function_dav_collection_delete", "permission": "contacts/read"},
		"dav/objects": {"function": "function_dav_objects", "permission": "contacts/read"},
		"dav/put": {"function": "function_dav_put", "permission": "contacts/read"},
		"dav/delete": {"function": "function_dav_delete", "permission": "contacts/read"}
	}
}
